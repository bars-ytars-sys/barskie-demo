---
import { Picture, Image, getImage } from 'astro:assets';
import fs from 'node:fs';
import Base from '../layouts/Base.astro';
import LeadForm from '../components/LeadForm.astro';
import { site, rub } from '../data/site';
import { houses, types } from '../data/houses';
import hero from '../assets/barski-autumn-hero.webp';
import bath from '../assets/relax/private-banya.jpg';
import chan from '../assets/relax/banya.webp';
import family from '../assets/relax/family.webp';
import food from '../assets/relax/food.webp';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const hasVideo=fs.existsSync('public/video/hero.mp4');
const og=await getImage({src:hero,width:1200,format:'jpg'});
const featured=[...houses].sort((a,b)=>['barski','chalet','barnhause1','river4','garden4','barnhause2'].indexOf(a.id)<0?1:['barski','chalet','barnhause1','river4','garden4','barnhause2'].indexOf(b.id)<0?-1:['barski','chalet','barnhause1','river4','garden4','barnhause2'].indexOf(a.id)-['barski','chalet','barnhause1','river4','garden4','barnhause2'].indexOf(b.id));
const pillars=[['Свой дом','15 домов и 5 форматов отдыха'],['Личная территория','У части домов полностью огорожена'],['Банный отдых','Банный чан, у части домов своя баня'],['Можно с питомцами','Приезжайте всей семьёй']];
const facts=[['15','загородных домов'],['5','форматов домов'],['1 час','от Москвы по Новой Риге'],['до 6','гостей в одном доме']];
const faq=[
['Как выбрать дом?','Укажите число гостей и пожелания: личная баня, огороженная территория или формат дома. Доступность и итоговая стоимость на ваши даты уточняются в онлайн-бронировании.'],
['Есть ли баня у каждого дома?','У части домов есть личная баня. В каталоге можно включить фильтр «Своя баня»; банные программы и дополнительные услуги уточняются при бронировании.'],
['Можно с животными?','Можно приезжать с питомцами. Перед бронированием уточните условия и доплату у отдела бронирования.'],
['Что входит в стоимость?','В домах есть кухня, постельное бельё, полотенца и мангал. Цена зависит от дома, дат и числа гостей; банный чан и дополнительные услуги уточняются отдельно.'],
['Где находится база?','Московская область, Новорижское шоссе, деревня Степаньково. Маршрут и контакты есть внизу страницы.'],
];
const jsonLd=[{'@context':'https://schema.org','@type':'Resort',name:site.legalName,url:site.url,telephone:site.phone,address:site.address,geo:{'@type':'GeoCoordinates',latitude:site.geo.lat,longitude:site.geo.lon}}, {'@context':'https://schema.org','@type':'FAQPage',mainEntity:faq.map(([q,a])=>({'@type':'Question',name:q,acceptedAnswer:{'@type':'Answer',text:a}}))}];
---
<Base title="База отдыха «Барские поля» в Подмосковье — дома с банным чаном" description="Барские поля: 15 загородных домов, банные чаны, личная территория и отдых с питомцами в часе от Москвы по Новой Риге." ogImage={og.src} jsonLd={jsonLd}>
  <section class="relative" data-hero-dark>
    <div class="relative isolate flex min-h-[88svh] items-center overflow-hidden text-white lg:min-h-[760px]">
      <Picture src={hero} formats={['avif','webp']} widths={[640,960,1280,1800,2200]} sizes="100vw" alt="Барский дом с террасой и беседкой — осенний кадр по фото Барских полей" loading="eager" fetchpriority="high" class="absolute inset-0 -z-30 h-full w-full object-cover object-[54%_center]" />
      {hasVideo && <video class="hero-video absolute inset-0 -z-20 h-full w-full object-cover object-[54%_center] opacity-0 transition-opacity duration-[1500ms]" muted loop playsinline preload="none" aria-hidden="true" data-desktop={`${base}/video/hero.webm|${base}/video/hero.mp4`} data-mobile={`${base}/video/hero-mobile.mp4`} />}
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgb(15_35_28/0.78),rgb(15_35_28/0.35)_60%,rgb(15_35_28/0.1))]"></div>
      <div class="wrap pt-28 pb-44 sm:pt-32 sm:pb-44">
        <a class="inline-flex items-center gap-3 rounded-full bg-mint py-1.5 pr-4 pl-1.5 text-sm font-semibold text-[#2a1606]" href="#special" data-reveal><span class="rounded-full bg-white px-3 py-1 text-xs">Тёплая осень</span>Время для загородного отдыха <span aria-hidden="true">→</span></a>
        <h1 class="mt-6 max-w-3xl text-[2.5rem] leading-[1.06] sm:text-6xl lg:text-[4.4rem]" data-reveal>База отдыха<br/>«Барские поля»<br/>в Подмосковье</h1>
        <p class="mt-5 max-w-lg text-base text-white/90 sm:text-lg" data-reveal style="--d:1">Дома с банным чаном у террасы, личная территория и неспешные дни — в часе от Москвы по Новой Риге.</p>
        <div class="mt-7 flex flex-wrap gap-3" data-reveal style="--d:2"><a href="#booking" class="btn bg-white text-ink hover:bg-mint">Онлайн-подбор дома</a><a href={site.phoneHref} class="btn-ghost hidden sm:inline-flex">{site.phone}</a></div>
      </div>
      <svg class="absolute inset-x-0 -bottom-px h-16 w-full text-page sm:h-24" viewBox="0 0 1440 100" preserveAspectRatio="none" aria-hidden="true"><path d="M0 60 C240 10 480 10 720 45 C960 80 1200 90 1440 40 L1440 100 L0 100 Z" fill="currentColor" /></svg>
    </div>
    <div id="booking" class="wrap relative z-10 -mt-32 sm:-mt-28">
      <form id="house-picker" class="card grid grid-cols-2 items-end gap-3 p-4 sm:p-6 lg:grid-cols-[1fr_1fr_0.7fr_auto]">
        <p class="col-span-2 flex items-center gap-2 font-semibold lg:col-span-4"><span class="dot text-mint-dark"></span>Онлайн-подбор дома</p>
        <label class="grid min-w-0 gap-1 text-xs font-semibold text-muted">Заезд<input name="dfrom" type="date" class="w-full rounded-xl border border-line bg-page px-3 py-3 text-base text-ink" /></label>
        <label class="grid min-w-0 gap-1 text-xs font-semibold text-muted">Выезд<input name="dto" type="date" class="w-full rounded-xl border border-line bg-page px-3 py-3 text-base text-ink" /></label>
        <label class="col-span-2 grid gap-1 text-xs font-semibold text-muted lg:col-span-1">Гостей<select name="adults" class="rounded-xl border border-line bg-page px-3 py-3 text-base text-ink">{[1,2,3,4,5,6].map(n=><option selected={n===2}>{n}</option>)}</select></label>
        <button class="btn-mint col-span-2 rounded-xl! lg:col-span-1" type="submit">Подобрать дом</button>
        <p id="date-error" class="col-span-2 text-sm text-red-800 lg:col-span-4" role="alert" hidden></p>
        <p class="col-span-2 text-xs text-muted lg:col-span-4">Подберём формат по числу гостей. Свободные даты и полная стоимость — на следующем шаге в онлайн-бронировании.</p>
      </form>
      <div class="mt-4 flex flex-wrap gap-2 text-xs text-muted"><a href={site.yandexMaps} class="rounded-full bg-card px-3 py-2">Яндекс · Хорошее место</a><a href="https://barskie-polya.ru/split" class="rounded-full bg-card px-3 py-2">Яндекс Сплит · оплата частями</a><span class="rounded-full bg-card px-3 py-2">С питомцами можно</span></div>
    </div>
    <div class="wrap mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">{pillars.map(([name,text],i)=><a href={i===2?'#relax':'#doma'} class="group flex gap-4" data-reveal><span class="grid size-11 shrink-0 place-items-center rounded-2xl bg-mint-soft text-mint-dark"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 20h18M5 20V10l7-6 7 6v10M10 20v-5h4v5"/></svg></span><span><b class="block">{name}</b><span class="mt-1 block text-sm text-muted">{text}</span></span></a>)}</div>
  </section>
  <section class="mt-16 bg-night py-14 text-white sm:mt-24 sm:py-20" aria-labelledby="scale-title"><div class="wrap"><p class="eyebrow text-mint" data-reveal>Своя территория отдыха</p><div class="mt-3 grid gap-6 lg:grid-cols-2"><h2 id="scale-title" class="h-section" data-reveal>Дом, в котором<br/>можно замедлиться</h2><p class="max-w-lg text-white/75 lg:justify-self-end" data-reveal>Уютные дома, террасы и вечера под открытым небом. Выберите свой формат: вдвоём, семьёй или небольшой компанией.</p></div><dl class="mt-10 grid grid-cols-2 gap-8 border-t border-white/15 pt-10 lg:grid-cols-4">{facts.map(([v,label])=><div data-reveal><dt class="font-display text-4xl text-mint sm:text-5xl">{v}</dt><dd class="mt-3 text-sm text-white/75">{label}</dd></div>)}</dl></div></section>
  <section class="overflow-hidden py-10" aria-label="Форматы домов"><div class="house-strip [mask-image:linear-gradient(90deg,transparent,black_4%,black_96%,transparent)]"><ul class="house-track flex w-max gap-3 px-4">{[...types,...types].map((t,i)=><li aria-hidden={i>=types.length?'true':undefined}><a href="#doma" data-type-link={t.id} tabindex={i>=types.length?-1:0} class="flex items-center gap-3 rounded-full bg-card py-2 pr-5 pl-2 shadow-sm transition hover:bg-mint-soft"><Image src={t.image} width={84} height={84} alt="" class="size-11 rounded-full object-cover"/><b class="whitespace-nowrap text-sm">{t.name}</b><span class="whitespace-nowrap text-xs text-muted">до {t.capacity} гостей</span></a></li>)}</ul></div></section>
  <section id="special" class="wrap pb-12 sm:pb-20" aria-labelledby="season-title"><div class="flex flex-wrap items-end justify-between gap-4"><div><p class="eyebrow" data-reveal>Специальные предложения</p><h2 id="season-title" class="h-section mt-3" data-reveal>Тёплая осень<br/>в Барских полях</h2></div><a href="https://barskie-polya.ru/special" class="btn-dark">Все акции →</a></div><div class="mt-8 grid gap-4 md:grid-cols-3">{[{title:'Банный отдых',text:'Горячий пар, личная баня и спокойный вечер. Выберите дом со своей баней.',image:bath,href:'#relax'},{title:'Выходные с близкими',text:'Своя территория, прогулки и время вместе. Дом по составу вашей компании.',image:family,href:'#doma'},{title:'Отдых без лишних забот',text:'Кухня в доме и возможность заказать питание. Посмотрите меню перед поездкой.',image:food,href:'https://barskie-polya.ru/menu'}].map(p=><article class="card overflow-hidden" data-reveal><Picture src={p.image} formats={['avif','webp']} widths={[360,640]} sizes="(min-width:768px) 33vw, 94vw" alt={p.title} class="aspect-[4/3] w-full object-cover"/><div class="p-5"><h3 class="text-2xl">{p.title}</h3><p class="mt-3 text-sm text-muted">{p.text}</p><a href={p.href} class="mt-5 inline-flex font-semibold text-sm text-mint-dark">Подробнее →</a></div></article>)}</div></section>
  <section id="doma" class="wrap pb-16 sm:pb-24" aria-labelledby="houses-title"><div class="flex flex-wrap items-end justify-between gap-4"><div><p class="eyebrow">Каталог домов</p><h2 id="houses-title" class="h-section mt-3">Выберите свой дом</h2><p class="mt-3 max-w-xl text-muted">Ривер и Гарден — до четырёх гостей. Шале, Барнхаусы и Барский дом — для тех, кому нужно больше пространства.</p></div><a href={site.booking} class="btn-dark">Свободные даты →</a></div>
    <div class="mt-7 flex flex-wrap gap-2" role="group" aria-label="Фильтр форматов"><button class="type-chip selected" data-filter="all" aria-pressed="true">Все дома</button>{types.map(t=><button class="type-chip" data-filter={t.id} aria-pressed="false">{t.name}</button>)}</div>
    <div class="mt-4 flex flex-wrap gap-4 text-sm"><label class="flex items-center gap-2"><input id="own-bath" type="checkbox" class="size-4 accent-[#815126]"/>Своя баня</label><label class="flex items-center gap-2"><input id="fenced" type="checkbox" class="size-4 accent-[#815126]"/>Огороженная территория</label></div><p id="matches" class="mt-4 text-sm text-muted" aria-live="polite">15 домов · цены от стоимости в будни</p>
    <div class="mt-6 grid gap-x-5 gap-y-9 sm:grid-cols-2 lg:grid-cols-3">{featured.map(h=><article data-house data-id={h.id} data-capacity={h.capacity} data-bath={String(h.bath)} data-fenced={String(h.fenced)} class="group relative" data-reveal><a href={h.url} class="block relative overflow-hidden rounded-[22px]"><Picture src={h.image} formats={['avif','webp']} widths={[360,540,760]} sizes="(min-width:1024px) 380px, (min-width:640px) 46vw,94vw" alt={`${h.name} — Барские поля`} class="aspect-[5/4] w-full object-cover transition duration-700 group-hover:scale-105"/><span class="absolute bottom-3 left-3 rounded-full bg-white px-3 py-2 text-sm font-bold">от {rub(h.price)}</span>{h.bath&&<span class="absolute top-3 left-3 rounded-full bg-night px-3 py-1.5 text-xs text-white">Своя баня</span>}</a><div class="pt-4"><h3 class="text-2xl"><a href={h.url}>{h.name}</a></h3><p class="mt-2 text-sm text-muted">До {h.capacity} гостей · {h.territory.toLowerCase()}</p><p class="mt-1 text-xs text-muted">{h.rooms}</p><div class="mt-4 flex items-center justify-between gap-2"><a href={h.url} class="text-sm font-semibold text-mint-dark">Посмотреть дом →</a><a href={`${site.booking}?onlyrooms=${h.roomId}`} data-book-room={h.roomId} class="rounded-full bg-night px-4 py-2.5 text-xs font-semibold text-white">Выбрать даты</a></div></div></article>)}</div><p id="empty" class="card mt-6 p-6 text-muted" hidden>Под эти пожелания дома не найдены. Снимите часть фильтров или напишите менеджеру — поможем выбрать формат.</p><p class="mt-6 text-xs text-muted">Цены со страниц домов, проверены 04.10.2026; итоговая стоимость зависит от дат, состава гостей и услуг. Подбор по характеристикам не подтверждает свободные места.</p>
  </section>
  <section id="relax" class="relative isolate overflow-hidden bg-night text-white"><Picture src={chan} formats={['avif','webp']} widths={[800,1400,1920]} sizes="100vw" alt="Осенний банный отдых" class="absolute inset-0 -z-20 h-full w-full object-cover"/><div class="absolute inset-0 -z-10 bg-night/80"></div><div class="wrap grid gap-9 py-16 sm:py-24 lg:grid-cols-2"><div data-reveal><p class="eyebrow text-mint">Ваш вечер за городом</p><h2 class="h-section mt-3">Тепло, тишина<br/>и банный отдых</h2><p class="mt-5 max-w-md text-white/80">Личная баня в выбранных домах, банный чан и отдых под открытым небом. Подберите дом под свой ритм.</p><a href="#doma" data-type-link="all" data-request-bath class="btn-mint mt-7">Дома со своей баней</a></div><Picture src={bath} formats={['avif','webp']} widths={[480,760,1000]} sizes="(min-width:1024px) 46vw,94vw" alt="Личная баня Барского дома" class="h-[350px] w-full rounded-[24px] object-cover sm:h-[420px]"/></div></section>
  <section class="wrap py-16 sm:py-24" aria-labelledby="how-title"><p class="eyebrow">Бронирование</p><h2 id="how-title" class="h-section mt-3">Три шага до отдыха</h2><ol class="mt-8 grid gap-4 md:grid-cols-3">{[['Выберите свой формат','Число гостей, баня, личная территория — оставьте только подходящие дома.'],['Проверьте даты и стоимость','Перейдите в онлайн-бронирование с выбранным домом и датами.'],['Приезжайте отдыхать','Уточните дополнительные услуги заранее; отдел бронирования на связи с 9:00 до 24:00.']].map(([title,text],i)=><li class="card p-6" data-reveal><span class="font-display text-4xl text-mint-dark">0{i+1}</span><h3 class="mt-4 text-2xl">{title}</h3><p class="mt-3 text-sm text-muted">{text}</p></li>)}</ol></section>
  <section class="wrap pb-16" aria-labelledby="faq-title"><p class="eyebrow">Перед поездкой</p><h2 id="faq-title" class="h-section mt-3">Частые вопросы</h2><div class="mt-8 grid gap-3">{faq.map(([q,a])=><details class="card p-5"><summary class="cursor-pointer font-semibold">{q}</summary><p class="mt-4 max-w-3xl text-sm text-muted">{a}</p></details>)}</div></section>
  <LeadForm/>
</Base>
<style>
.house-track{animation:marquee 50s linear infinite}.house-strip:hover .house-track,.house-strip:focus-within .house-track{animation-play-state:paused}.type-chip{padding:12px 18px;background:var(--color-card);border:1px solid var(--color-line);border-radius:999px;font-size:14px;cursor:pointer}.type-chip.selected{background:var(--color-night);color:white;border-color:var(--color-night)}
@media(max-width:399px){#house-picker{grid-template-columns:minmax(0,1fr)}#house-picker>*{grid-column:1}}@media(hover:none),(max-width:767px){.house-track{animation:none}.house-strip{overflow-x:auto;mask-image:none}}@media(prefers-reduced-motion:reduce){.house-track{animation:none}}
</style>
<script>
document.addEventListener('astro:page-load',()=>{
 const form=document.querySelector<HTMLFormElement>('#house-picker');if(!form)return;
 const arrival=form.elements.namedItem('dfrom') as HTMLInputElement,departure=form.elements.namedItem('dto') as HTMLInputElement,guests=form.elements.namedItem('adults') as HTMLSelectElement;
 const bath=document.querySelector<HTMLInputElement>('#own-bath')!,fenced=document.querySelector<HTMLInputElement>('#fenced')!;
 const chips=document.querySelectorAll<HTMLButtonElement>('[data-filter]'),cards=document.querySelectorAll<HTMLElement>('[data-house]');let type='all';
 const today=new Intl.DateTimeFormat('sv-SE',{timeZone:'Europe/Moscow'}).format(new Date());arrival.min=today;departure.min=today;
 const refresh=()=>{let n=0;cards.forEach(card=>{const show=(type==='all'||card.dataset['id']?.startsWith(type))&&Number(card.dataset['capacity'])>=Number(guests.value)&&(!bath.checked||card.dataset['bath']==='true')&&(!fenced.checked||card.dataset['fenced']==='true');card.hidden=!show;if(show)n++;});chips.forEach(c=>{const on=c.dataset['filter']===type;c.classList.toggle('selected',on);c.setAttribute('aria-pressed',String(on));});document.querySelector('#matches')!.textContent=`Подходящих домов: ${n} · доступность уточняется на ваши даты`;document.querySelector<HTMLElement>('#empty')!.hidden=n>0;};
 const setType=(value:string)=>{type=value;refresh();};chips.forEach(c=>c.addEventListener('click',()=>setType(c.dataset['filter']!)));
 document.querySelectorAll<HTMLAnchorElement>('[data-type-link]').forEach(a=>a.addEventListener('click',()=>{if(a.hasAttribute('data-request-bath'))bath.checked=true;setType(a.dataset['typeLink']!);}));
 [bath,fenced,guests].forEach(x=>x.addEventListener('change',refresh));arrival.addEventListener('change',()=>{departure.min=arrival.value||today;});
 const error=document.querySelector<HTMLElement>('#date-error')!;
 const dateError=()=>arrival.value&&arrival.value<today?'Дата заезда уже прошла.':Boolean(arrival.value)!==Boolean(departure.value)?'Укажите обе даты или оставьте их пустыми.':arrival.value&&departure.value<=arrival.value?'Выезд должен быть позже заезда.':'';
 form.addEventListener('submit',e=>{e.preventDefault();const message=dateError();error.textContent=message;error.hidden=!message;if(message)return;refresh();document.querySelector('#doma')?.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});});
 document.querySelectorAll<HTMLAnchorElement>('[data-book-room]').forEach(a=>a.addEventListener('click',e=>{const message=dateError();if(message){e.preventDefault();error.hidden=false;error.textContent=message;form.scrollIntoView();return;}const u=new URL('https://barskie-polya.ru/booking');u.searchParams.set('onlyrooms',a.dataset['bookRoom']!);u.searchParams.set('adults',guests.value);if(arrival.value){u.searchParams.set('dfrom',arrival.value);u.searchParams.set('dto',departure.value);}a.href=u.href;}));
 const video=document.querySelector<HTMLVideoElement>('.hero-video');const conn=(navigator as Navigator & {connection?:{saveData?:boolean}}).connection;
 if(video&&!conn?.saveData&&!matchMedia('(prefers-reduced-motion: reduce)').matches){const start=()=>{const mobile=matchMedia('(max-width:640px)').matches;const sources=((mobile?video.dataset['mobile']:video.dataset['desktop'])?.split('|')??[]);sources.forEach(src=>{const s=document.createElement('source');s.src=src;s.type=src.endsWith('.webm')?'video/webm':'video/mp4';video.append(s);});video.load();video.addEventListener('playing',()=>video.classList.remove('opacity-0'),{once:true});video.play().catch(()=>{});};if(document.readyState==='complete')setTimeout(start,600);else addEventListener('load',()=>setTimeout(start,600),{once:true});}
});
</script>
